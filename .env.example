# YouVersion OAuth credentials (from https://platform.youversion.com/)
# In the YouVersion flow, the app_key IS the OAuth client_id
YOUVERSION_CLIENT_ID=your_app_key_here

# X-YVP-App-Key — used for API data calls (bibles, passages, highlights)
YOUVERSION_API_KEY=your_api_key_here

# Full OAuth callback URL — must match what's registered in the platform portal
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Default Bible version ID  (1=KJV, 111=NIV, 59=ESV, 206=NLT, 3034=BSB)
DEFAULT_BIBLE_ID=1
